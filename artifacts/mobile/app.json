{
  "expo": {
    "name": "TokVid",
    "slug": "mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/brand-kit/identidad-visual-TV/3d/app-icon-1024.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand-kit/identidad-visual-TV/3d/logo-3d-transparente-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C959F"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Tokvid necesita acceso a la cámara para videollamadas.",
        "NSMicrophoneUsageDescription": "Tokvid necesita acceso al micrófono para llamadas de voz y video."
      }
    },
    "android": {
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-kit/identidad-visual-TV/3d/logo-3d-transparente-1024.png",
        "backgroundColor": "#0C959F",
        "monochromeImage": "./assets/brand-kit/identidad-visual-TV/vector/isotipo-blanco-1024.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/brand-kit/identidad-visual-TV/favicon/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Tokvid necesita acceso a la cámara para videollamadas.",
          "microphonePermission": "Tokvid necesita acceso al micrófono para llamadas de voz y video."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FE2C55",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Tokvid"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TokVid necesita el micrófono para grabar mensajes de voz."
        }
      ],
      [
        "./plugins/withChatTranslation"
      ],
      [
        "./plugins/withTokvidVideoTrim"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-kit/identidad-visual-TV/3d/logo-3d-transparente-1024.png",
          "backgroundColor": "#0C959F",
          "imageWidth": 200
        }
      ],
      [
        "./plugins/withSafeBrandIcon"
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#000000"
  }
}
