# Supabase Configuration (for Web/Next.js apps)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Configuration (for Mobile/Expo apps)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (required for admin actions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database configuration
DATABASE_URL=postgres://user:password@host:5432/database

# Expo deployment variables
# EXPO_PUBLIC_DOMAIN=your-deploy-domain
# EXPO_PUBLIC_REPL_ID=your-expo-public-id
# PORT (default: 3000)
