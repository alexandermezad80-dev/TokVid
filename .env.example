# Supabase Configuration (for Web/Next.js apps)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Configuration (for Mobile/Expo apps)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (required for admin actions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database configuration
DATABASE_URL=postgres://user:password@host:5432/database

# Replit Environment Variables (set automatically in Replit)
# REPLIT_DEV_DOMAIN
# REPLIT_EXPO_DEV_DOMAIN
# REPL_ID
# PORT (default: 3000)
